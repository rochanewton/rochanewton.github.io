{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "ignorePaths": [
    "themes/**",
    "public/**",
    "resources/**",
    ".git/**",
    "*.svg",
    "*.webp",
    "*.png",
    "*.jpg",
    "package-lock.json"
  ],
  "overrides": [
    {
      "filename": [
        "**/*.pt-br.md",
        "archetypes/**",
        "README.md"
      ],
      "language": "en,pt-BR"
    }
  ],
  "ignoreRegExpList": [
    "\\{\\{[<%][\\s\\S]*?[>%]\\}\\}",
    "\\]\\([^)]*\\)",
    "`[^`\\n]*`",
    "https?://\\S+"
  ],
