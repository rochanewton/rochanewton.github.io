{
  "default": true,
  // Linhas longas são normais em prosa
  "MD013": false,
  // Shortcodes Hugo e HTML inline (quiz, figure, mermaid)
  "MD033": false,
  // O título vem do front matter, não de um "# " no corpo
  "MD041": false,
  "MD025": { "front_matter_title": "^\\s*title\\s*[:=]" },
  // Mesmo título de seção em partes diferentes do post é ok
  "MD024": { "siblings_only": true },
  //Falso positivo: diagramas indentados dentro do shortcode {{< mermaid >}}
  "MD046": false,
  // Falso positivo: URLs em parâmetros de shortcodes ({{< cta url="…" >}}) não podem levar < >
  "MD034": false
}
